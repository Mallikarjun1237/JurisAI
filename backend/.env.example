# Copy this file to .env or paste into your Cloud Host Environment Dashboard (Render / Railway)
# AI Inference Providers (Get Gemini key: https://aistudio.google.com | Groq key: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

SECRET_KEY=change-this-to-a-random-secret-key
DATABASE_URL=sqlite:///./jurisai.db
CHROMA_PATH=./.chroma_db
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production Frontend URL & CORS
FRONTEND_URL=https://your-frontend-app.vercel.app
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app

# Gmail SMTP for password reset emails (optional)
# Get App Password at: myaccount.google.com/apppasswords
SMTP_EMAIL=your_gmail@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587