# ==============================================================================
# JurisAI Backend Environment Variables (.env)
# ==============================================================================

# LLM Providers (At least one is required)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Security & JWT Tokens
SECRET_KEY=generate_a_long_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — Neon Lakebase Postgres (Managed)
DATABASE_URL=postgresql://neondb_owner:<password>@<host>:<port>/<database>?sslmode=require&channel_binding=require

# Neon Object Storage (S3-Compatible Document Storage)
AWS_ACCESS_KEY_ID=<your_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key>
AWS_ENDPOINT_URL_S3=<your_neon_s3_endpoint_url>
AWS_REGION=<your_aws_region>

# Neon Realtime
NEON_REALTIME_URL=<your_neon_realtime_url>
NEON_REALTIME_SECRET=<your_neon_realtime_secret>

# Vector DB
CHROMA_PATH=./.chroma_db

# Password Reset Email (SMTP)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Allowed Frontend Origins (For CORS)
FRONTEND_URL=https://your-frontend-domain.vercel.app
